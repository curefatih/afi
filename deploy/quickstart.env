# Local-only defaults for `make quickstart`.
# Do NOT use these values on a public or shared host — see docs/deployment/customization.md.
# Quick start always uses the `full` Compose profile.

COMPOSE_PROJECT_NAME=afi

POSTGRES_USER=afi
POSTGRES_PASSWORD=afi-quickstart-db
POSTGRES_DB=afi
POSTGRES_HOST_PORT=5432

REDIS_HOST_PORT=6379

CONTROLPLANE_HOST_PORT=8081
GATEWAY_HOST_PORT=8080
WEB_HOST_PORT=3000

AFI_DATABASE_URL=postgres://afi:afi-quickstart-db@postgres:5432/afi?sslmode=disable
AFI_REDIS_URL=redis://redis:6379/0
AFI_JWT_SECRET=afi-quickstart-jwt-secret-change-before-prod
AFI_INTERNAL_TOKEN=afi-quickstart-internal-token
AFI_TOKEN_TTL=24h
AFI_CONTROLPLANE_ADDR=:8081
AFI_GATEWAY_ADDR=:8080
AFI_SNAPSHOT_POLL_INTERVAL=2s

AFI_EVENTS_OUTBOX_ENABLED=false
AFI_EVENTS_PUBLISHER=log

# Set at least one provider key for live inference.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

VITE_PLATFORM_API_URL=http://localhost:8081
VITE_GATEWAY_API_URL=http://localhost:8080
VITE_GATEWAY_API_KEY=

AFI_MAIL_PUBLIC_APP_URL=http://localhost:3000
AFI_MAIL_FROM=AFI <noreply@afi.local>
AFI_MAIL_DEFAULT_PROVIDER=log
